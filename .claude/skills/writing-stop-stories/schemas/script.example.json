  "music": null,
  "text": [
    {
      "heading": "Wał, który hamował miasto",
      "paragraphs": [
        {
          "sentences": [
            {
              "text": "Wał Lubomirskiego nie tylko chronił przed zarazą. Był też granicą celną.",
              "fact_ids": ["F3"]
            },
            {
              "text": "Ulica Okopowa biegła po jego wewnętrznej stronie.",
